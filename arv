#!/bin/sh
# arv in a checkout: runs src/arv/build/arv, building everything with make first if it is missing.
# (Installed, arv is the program itself: make install.)
here=$(cd "$(dirname "$0")" && pwd)
[ -x "$here/src/arv/build/arv" ] || make -s -C "$here" >&2 || exit 1
exec "$here/src/arv/build/arv" "$@"
