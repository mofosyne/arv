# from a tarball, where there is no git to ask
COMMIT export-subst
# Not part of the tool snapshot that `arv make` puts on every disc (git archive HEAD)
samples/discs export-ignore
samples/home export-ignore
docs/screenshots export-ignore
docs/demo export-ignore
